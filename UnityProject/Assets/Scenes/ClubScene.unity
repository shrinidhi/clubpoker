  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Fee Allocation explanation:\n\nIf player A, B, C put 40 chips, 40 chips,
    20 chips into the pot, the total pot is 100 chips. A is the winner, B and C are
    the losers. The whole pot (player A, B, C) got into the pot divide the total
    pot to 40%, 40%, 20%, fee is 5% of the pot. So the total fee is 5 chips.\n\n1.
    If you set fee allocation as 0%, the fee will be distributed between players
    according to how many chips they put into the pot, so the fee counted to each
    player is:\nPlayer A: 5\xD740% = 2\nPlayer B: 5\xD740% = 2\nPlayer C: 5\xD720%
    = 1\n\n2. If you set fee allocation as 60%, 60% of the total fee will only be
    distributed between losers, the rest 40% of the total fee will be distributed
    between winners and losers according to how many chips they put into the pot."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fce88056280d54ed79a4053fb5f9407a, type: 2}
  m_sharedMaterial: {fileID: 4984324747018414052, guid: fce88056280d54ed79a4053fb5f9407a, type: 2}
