<?xml version="1.0" encoding="utf-8"?>
<!-- Google sign-in libraries, picked up by External Dependency Manager.
     Android: Credential Manager for Plugins/Android/GoogleSignInBridge.java —
     run Android Resolver → Force Resolve.
     iOS: Google Sign-In SDK for Plugins/iOS/GoogleSignInBridge.mm — installed
     by CocoaPods when the Xcode project is generated. -->
<dependencies>
    <androidPackages>
        <androidPackage spec="androidx.credentials:credentials:1.3.0" />
        <androidPackage spec="androidx.credentials:credentials-play-services-auth:1.3.0" />
        <androidPackage spec="com.google.android.libraries.identity.googleid:googleid:1.1.1" />
    </androidPackages>
    <iosPods>
        <iosPod name="GoogleSignIn" version="~> 8.0" />
    </iosPods>
</dependencies>
