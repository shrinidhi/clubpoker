  m_Script: {fileID: 11500000, guid: d3484ea41a4e540aba1e5ad25246ae72, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Close_Button: {fileID: 804893389}
  Tip_Button: {fileID: 283273220}
  TipMessage: "Fee Allocation explanation:\n\nIf player A, B, C put 40 chips, 40
    chips, 20 chips into the pot, the total pot is 100 chips. A is the winner, B
    and C are the losers. The whole pot (player A, B, C) got into the pot divide
    the total pot to 40%, 40%, 20%, fee is 5% of the pot. So the total fee is 5 chips.\n\n1.
    If you set fee allocation as 0%, the fee will be distributed between players
    according to how many chips they put into the pot, so the fee counted to each
    player is:\nPlayer A: 5\xD740% = 2\nPlayer B: 5\xD740% = 2\nPlayer C: 5\xD720%
    = 1\n\n2. If you set fee allocation as 60%, 60% of the total fee will only be
    distributed between losers, the rest 40% of the total fee will be distributed
    between winners and losers according to how many chips they put into the pot."
  Percent_Slider: {fileID: 1197660804}
  Percent_Text: {fileID: 1490260268}
  Confirm_Button: {fileID: 783020329}
  AlertPopup: {fileID: 2092260615}
  AdminPanel: {fileID: 1136905232}
